# 宿主机映射端口（默认统一使用 3032）
APP_PORT=3032

# 节点环境
NODE_ENV=production

# =========================================================
# AI 智能长文总结配置 (支持 Gemini / OpenAI / Claude)
# =========================================================

# 当前启用的 AI 提供商: "gemini" | "openai" | "claude" (默认: gemini)
AI_PROVIDER=gemini

# 指定使用的具体模型 (留空则使用推荐性价比默认模型)
# - gemini 推荐: gemini-2.0-flash 或 gemini-1.5-flash
# - openai 推荐: gpt-4o-mini 或 gpt-4o / deepseek-chat
# - claude 推荐: claude-3-5-haiku-20241022 或 claude-3-5-sonnet-20241022
AI_MODEL=gemini-2.0-flash

# 1. Google Gemini 配置 (推荐：有永久免费额度，15次/分，1500次/天)
# 免费申请地址：https://aistudio.google.com
GEMINI_API_KEY=

# 2. OpenAI 配置 (也兼容 DeepSeek / OneAPI / 任意中转站)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Anthropic Claude 配置
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

